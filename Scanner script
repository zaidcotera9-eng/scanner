function UI.section(parent, text)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Parent = parent,
	})
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })
	pad(holder, 4, 0, 4, 0)
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, Text = string.upper(text), TextSize = 10,
		TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})
	return holder
end

function UI.toggle(parent, text, default, callback)
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = ROW, BackgroundTransparency = 0.15,
		Text = "", AutoButtonColor = false, Parent = parent,
	})
	corner(row, 6); pad(row, 0, 8, 0, 10)

	new("TextLabel", {
		Size = UDim2.new(0.7, 0, 1, 0), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, Text = text, TextSize = 13, TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})

	local pill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(34, 18), BackgroundColor3 = default and ACCENT or Color3.fromRGB(58, 58, 70), Parent = row,
	})
	corner(pill, 999)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = default and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), Parent = pill,
	})
	corner(knob, 999)

	local state = default
	local function render()
		pill.BackgroundColor3 = state and ACCENT or Color3.fromRGB(58, 58, 70)
		TweenService:Create(knob, TweenInfo.new(0.15), {
			Position = state and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
		}):Play()
	end

	row.MouseButton1Click:Connect(function()
		state = not state; render()
		if callback then callback(state) end
	end)
	render()
	return row
end

function UI.slider(parent, text, min, max, default, suffix, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = ROW,
		BackgroundTransparency = 0.15, Parent = parent,
	})
	corner(holder, 6); pad(holder, 7, 10, 8, 10)

	new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 14), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, Text = text, TextSize = 12, TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})
	local val = new("TextLabel", {
		Size = UDim2.new(0.4, 0, 0, 14), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, Text = tostring(default) .. (suffix or ""), TextSize = 12,
		TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Right, Parent = holder,
	})

	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Color3.fromRGB(48, 48, 60), Parent = holder,
	})
	corner(track, 999)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ACCENT, Parent = track })
	corner(fill, 999)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = track,
	})
	corner(knob, 999)

	local value, dragging = default, false
	local function set(v)
		value = math.clamp(v, min, max)
		local p = (value - min) / (max - min)
		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		val.Text = tostring(math.floor(value * 100) / 100) .. (suffix or "")
		if callback then callback(value) end
	end
	set(default)

	local function fromPos(x)
		local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		set(min + rel * (max - min))
	end

	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; fromPos(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromPos(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return holder
end

function UI.segment(parent, text, options, default, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = ROW,
		BackgroundTransparency = 0.15, Parent = parent,
	})
	corner(holder, 6); pad(holder, 7, 10, 8, 10)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, Text = text, TextSize = 12, TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})

	local row = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Parent = holder,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = row })

	local buttons = {}
	for _, opt in ipairs(options) do
		local b = new("TextButton", {
			Size = UDim2.new(1 / #options, -4, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 50),
			Font = Enum.Font.GothamBold, Text = opt, TextSize = 11, TextColor3 = TXT,
			AutoButtonColor = false, Parent = row,
		})
		corner(b, 5)
		buttons[opt] = b
	end

	local function select(opt, fire)
		for name, b in pairs(buttons) do
			b.BackgroundColor3 = name == opt and ACCENT or Color3.fromRGB(40, 40, 50)
		end
		if fire and callback then callback(opt) end
	end

	for opt, b in pairs(buttons) do
		b.MouseButton1Click:Connect(function() select(opt, true) end)
	end
	select(default, false)
	return holder
end

function UI.keybind(parent, text, default, callback)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = ROW,
		BackgroundTransparency = 0.15, Parent = parent,
	})
	corner(row, 6); pad(row, 0, 8, 0, 10)

	new("TextLabel", {
		Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, Text = text, TextSize = 13, TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})

	local box = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(62, 20), BackgroundColor3 = Color3.fromRGB(40, 40, 50),
		Font = Enum.Font.GothamBold, Text = default.Name, TextSize = 11,
		TextColor3 = GOLD, AutoButtonColor = false, Parent = row,
	})
	corner(box, 5)

	box.MouseButton1Click:Connect(function()
		box.Text = "..."; capturing = true
		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				box.Text = input.KeyCode.Name
				capturing = false
				if callback then callback(input.KeyCode) end
				conn:Disconnect()
			end
		end)
	end)
	return row
end

