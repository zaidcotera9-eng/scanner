--=====================================================================
--  LOGICA AIMBOT
--=====================================================================
local function sameTeam(plr)
	if not CONFIG.TeamCheck then return false end
	return LP.Team ~= nil and plr.Team == LP.Team
end

local function getPart(char)
	return char:FindFirstChild(aimPart) or char:FindFirstChild("HumanoidRootPart")
end

local function isVisible(part)
	if not CONFIG.WallCheck then return true end
	local origin = Camera.CFrame.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LP.Character }
	params.IgnoreWater = true
	local hit = Workspace:Raycast(origin, part.Position - origin, params)
	return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
end

local function predictedPos(part)
	if not CONFIG.Prediction then return part.Position end
	local dist = (part.Position - Camera.CFrame.Position).Magnitude
	return part.Position + part.AssemblyLinearVelocity * (dist / CONFIG.BulletSpeed)
end

local function findTarget()
	local center = Camera.ViewportSize * 0.5
	local best, bestScore = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not sameTeam(plr) then
			local char = plr.Character
			if char then
				local hum, part = char:FindFirstChildOfClass("Humanoid"), getPart(char)
				if hum and part and hum.Health > 0 then
					local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
					if onScreen and sp.Z > 0 then
						local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if d2 <= CONFIG.FOV and d2 < bestScore then
							local d3 = (part.Position - Camera.CFrame.Position).Magnitude
							if d3 <= CONFIG.MaxDistance and isVisible(part) then
								best, bestScore = { char = char, part = part }, d2
							end
						end
					end
				end
			end
		end
	end
	return best
end

local function setHighlight(char)
	if hlChar == char then return end
	if highlight then highlight:Destroy(); highlight = nil end
	hlChar = char
	if char then
		highlight = new("Highlight", {
			FillColor = Color3.fromRGB(255, 60, 60), FillTransparency = 0.75,
			OutlineColor = Color3.fromRGB(255, 60, 60),
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = char, Parent = char,
		})
	end
end

