if type(_G.VeniceCleanup) == "function" then pcall(_G.VeniceCleanup) end

local CONN, espCache, gui = {}, {}, nil
local RENDER_NAME = "VeniceRender_v4"
local warned = false

local function bind(sig, fn)
	local c = sig:Connect(fn)
	CONN[#CONN + 1] = c
	return c
end

local function cleanup()
	for _, c in ipairs(CONN) do pcall(function() c:Disconnect() end) end
	table.clear(CONN)
	for _, data in pairs(espCache) do
		for _, obj in pairs(data) do
			if typeof(obj) == "Instance" then pcall(function() obj:Destroy() end) end
		end
	end
	table.clear(espCache)
	pcall(function() RunService:UnbindFromRenderStep(RENDER_NAME) end)
	if gui then pcall(function() gui:Destroy() end) end
end
_G.VeniceCleanup = cleanup

