local function fovRadius()
	local vp = Camera.ViewportSize
	local camFov = math.rad(Camera.FieldOfView > 0 and Camera.FieldOfView or 70)
	return (math.tan(math.rad(state.fov) / 2) / math.tan(camFov / 2)) * (vp.Y / 2)
end

local function updateFovCircle()
	local r = math.clamp(fovRadius(), 4, 4000)
	fovCircle.Size
