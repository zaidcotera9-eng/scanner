local function new(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	return inst
end
local function corner(obj, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r), Parent = obj })
end
local function pad(obj, t, r, b, l)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, l or 0), Parent = obj,
	})
end

