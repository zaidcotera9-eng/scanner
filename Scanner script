end

function UI.toggle(parent, text, default, callback)
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = ROW, BackgroundTransparency = 0.15,
		Text = "", AutoButtonColor = false, Parent = parent,
	})
	corner(row, 6); pad(row, 0, 8, 0, 10)
	new("TextLabel", {
		Size = UDim2.new(0.7, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
		Text = text, TextSize = 13, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local pill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(34, 18), BackgroundColor3 = Color3.fromRGB(58, 58, 70), Parent = row,
	})
	corner(pill, 999)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), Parent = pill,
	})
	corner(knob, 999)

	local value = default
	local function render()
		pill.BackgroundColor3 = value and ACCENT or Color3.fromRGB(58, 58, 70)
		TweenService:Create(knob, TweenInfo.new(0.15), {
			Position = value and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
		}):Play()
	end
	local function set(v)
		value = v and true or false
		render()
		if callback then callback(value) end
	end
	row.MouseButton1Down:Connect(function() set(not value) end)
	set(default)
	return row, set
end

function UI.slider(parent, text, min, max, default, suffix, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = ROW, BackgroundTransparency = 0.15, Parent = parent,
	})
	corner(holder, 6); pad(holder, 7, 10, 8, 10)
	new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
		Text = text, TextSize = 12, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})
	local val = new("TextLabel", {
		Size = UDim2.new(0.4, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
		Text = "", TextSize = 12, TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = holder,
	})
	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Color3.fromRGB(48, 48, 60), Parent = holder,
	})
	corner(track, 999)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ACCENT, Parent = track })
	corner(fill, 999)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = track,
	})
	corner(knob, 999)

	local dragging = false
	local function set(v, silent)
		v = math.clamp(v, min, max)
		local p = (v - min) / (max - min)
		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
		val.Text = tostring(math.floor(v * 100) / 100) .. (suffix or "")
		if not silent and callback then callback(v) end
	end
	set(default, true)
	if callback then callback(default) end

	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			set(min + rel * (max - min))
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			set(min + rel * (max - min))
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return holder, set
end

function UI.segment(parent, text, options, default, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = ROW, BackgroundTransparency = 0.15, Parent = parent,
	})
	corner(holder, 6); pad(holder, 6, 8, 6, 8)
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
		Text = text, TextSize = 12, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
	})
	local row = new("Frame", {
		Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1, Parent = holder,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = row,
	})
	local btns, current = {}, default
	local function render()
		for name, b in pairs(btns) do
			b.BackgroundColor3 = (name == current) and ACCENT or Color3.fromRGB(45, 45, 56)
		end
	end
	for _, name in ipairs(options) do
		local b = new("TextButton", {
			Size = UDim2.new(1 / #options, -4, 1, 0), BackgroundColor3 = Color3.fromRGB(45, 45, 56),
			Text = name, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = TXT,
			AutoButtonColor = false, Parent = row,
		})
		corner(b, 4)
		btns[name] = b
		b.MouseButton1Down:Connect(function()
			current = name; render()
			if callback then callback(name) end
		end)
	end
	render()
	return holder, function(v)
		if btns[v] then
			current = v; render()
			if callback then callback(v) end
		end
	end
end

function UI.button(parent, text, callback)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = ACCENT2, Text = text,
		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = true, Parent = parent,
	})
	corner(b, 6)
	b.MouseButton1Down:Connect(function() if callback then callback() end end)
	return b
end

