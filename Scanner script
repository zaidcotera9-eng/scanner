local espCache = {}

local function getESP(plr)
	if espCache[plr] then return espCache[plr] end
	local d = {}
	d.box = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui })
	d.box.ZIndex = 1
	d.stroke = new("UIStroke", { Thickness = 1.2, Color = Color3.fromRGB(255, 70, 70), Parent = d.box })
	d.name = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Size = UDim2.new(3, 0, 0, 12), Parent = gui })
	d.name.ZIndex = 1
	d.dist = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = GOLD, TextStrokeTransparency = 0.5, Size = UDim2.new(3, 0, 0, 11), Parent = gui })
	d.dist.ZIndex = 1
	d.hp = new("Frame", { BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = gui })
	d.hp.ZIndex = 1
	d.hpFill = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 220, 100), BorderSizePixel = 0, Parent = d.hp })
	d.tracer = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 70, 70), BackgroundTransparency = 0.5, Size = UDim2.fromOffset(0, 1), Parent = gui })
	d.tracer.ZIndex = 1
	espCache[plr] = d
	return d
end

local function hideESP(d)
	for _, v in pairs({ d.box, d.name, d.dist, d.hp, d.tracer }) do v.Visible = false end
end

Players.PlayerRemoving:Connect(function(plr)
	local d = espCache[plr]
	if d then
		for _, v in pairs({ d.box, d.name, d.dist, d.hp, d.tracer }) do v:Destroy() end
		espCache[plr] = nil
	end
end)

local function updateESP()
	local vh = Camera.ViewportSize.Y
	local focal = vh / (2 * math.tan(math.rad(Camera.FieldOfView) / 2))
	for _, plr in ipairs(Players:GetPlayers()) do
		local d = getESP(plr)
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local skip = (not CONFIG.ESP) or plr == LP or not root or not hum or hum.Health <= 0 or sameTeam(plr)
		if skip then
			hideESP(d)
		else
			local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
			local dist = (Camera.CFrame.Position - root.Position).Magnitude
			if not onScreen or dist > CONFIG.MaxDistance * 1.5 then
				hideESP(d)
			else
				local h = (5.5 / dist) * focal
				local w = h * 0.55
				d.box.Visible = CONFIG.ESPBox
				d.box.Size = UDim2.fromOffset(w, h)
				d.box.Position = UDim2.fromOffset(pos.X - w / 2, pos.Y - h / 2)
				d.stroke.Color = plr.Team == LP.Team and Color3.fromRGB(90, 200, 255) or Color3.fromRGB(255, 70, 70)

				d.name.Visible = CONFIG.ESPName
				d.name.Text = plr.Name
				d.name.Position = UDim2.fromOffset(pos.X - (w * 1.5) / 2, pos.Y - h / 2 - 14)

				d.dist.Visible = CONFIG.ESPDist
				d.dist.Text = string.format("%d studs", dist)
				d.dist.Position = UDim2.fromOffset(pos.X - (w * 1.5) / 2, pos.Y + h / 2 + 1)

				d.hp.Visible = CONFIG.ESPHealth
				d.hp.Size = UDim2.fromOffset(3, h)
				d.hp.Position = UDim2.fromOffset(pos.X - w / 2 - 6, pos.Y - h / 2)
				d.hpFill.Size = UDim2.new(1, 0, hum.Health / hum.MaxHealth, 0)
				d.hpFill.Position = UDim2.new(0, 0, 1 - hum.Health / hum.MaxHealth, 0)
				d.hpFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - hum.Health / hum.MaxHealth), 220 * (hum.Health / hum.MaxHealth), 90)

				d.tracer.Visible = CONFIG.ESPTracer
				if CONFIG.ESPTracer then
					local from = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					local to = Vector2.new(pos.X, pos.Y)
					local delta = to - from
					d.tracer.Size = UDim2.fromOffset(delta.Magnitude, 1)
					d.tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					d.tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
				end
			end
		end
	end
end

--=====================================================================
--  LOOP PRINCIPAL
--=====================================================================
local function onRender(dt)
	if updateESP then updateESP() end

	if not enabled or (CONFIG.RequireADS and not holding) then
		setHighlight(nil)
		return
	end
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	local t = findTarget()
	if not t then setHighlight(nil); return end

	if CONFIG.ESPChams then setHighlight(t.char) else setHighlight(nil) end

	local desired = CFrame.lookAt(Camera.CFrame.Position, predictedPos(t.part))
	local alpha = CONFIG.Smoothness <= 0 and 1 or (1 - math.exp(-dt / CONFIG.Smoothness))
	Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
end

RunService:BindToRenderStep("VeniceAimbot", Enum.RenderPriority.Camera.Value + 1, onRender)

