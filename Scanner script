--[[
=====================================================================
 SISTEMA DE ROBO + "AUTO ROBAR" (para TU juego en Roblox Studio)
=====================================================================
 Preparación en el Workspace:
  - Crea una carpeta "Bases" con un Model por jugador (Base1, Base2...).
  - Dentro de cada Model pon:
      * Varias Parts que serán los pedestales (en Properties > Tags
        agrégales la etiqueta "Pedestal" con la ventana Tag Editor).
      * Una Part llamada "ZonaDeposito" (donde se dejan los objetos robados).
  - Cada pedestal usa el atributo "Item" (texto). Vacío = libre.

 Scripts:
  1) Script      "RobarServidor"  -> ServerScriptService
  2) LocalScript "RobarCliente"   -> StarterGui
=====================================================================
]]


--====================================================================
-- 1) Script "RobarServidor"  (ServerScriptService)
--====================================================================
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GAMEPASS_ID = 0   -- ID de tu gamepass "Auto Robar" (0 = libre para pruebas)
local RANGO = 15        -- distancia máxima para robar (studs)
local COOLDOWN = 3      -- segundos entre robos

-- Remotos
local remotos = Instance.new("Folder")
remotos.Name = "RobarRemotos"
remotos.Parent = ReplicatedStorage
local autoRobarEvento = Instance.new("RemoteEvent")
autoRobarEvento.Name = "AutoRobar"
autoRobarEvento.Parent = remotos
local alertaEvento = Instance.new("RemoteEvent")
alertaEvento.Name = "Alerta"
alertaEvento.Parent = remotos

-- Asignar una base libre a cada jugador
local function asignarBase(jugador)
	local bases = workspace:WaitForChild("Bases")
	for _, base in ipairs(bases:GetChildren()) do
		if base:GetAttribute("Dueno") == jugador.UserId then return end
	end
	for _, base in ipairs(bases:GetChildren()) do
		if not base:GetAttribute("Dueno") then
			base:SetAttribute("Dueno", jugador.UserId)
			break
		end
	end
end

Players.PlayerAdded:Connect(asignarBase)
-- En Studio el jugador puede entrar antes de que el script conecte el evento
for _, jugador in ipairs(Players:GetPlayers()) do
	task.spawn(asignarBase, jugador)
end

Players.PlayerRemoving:Connect(function(jugador)
	for _, base in ipairs(workspace.Bases:GetChildren()) do
		if base:GetAttribute("Dueno") == jugador.UserId then
			base:SetAttribute("Dueno", nil)
			for _, ped in ipairs(base:GetDescendants()) do
				if CollectionService:HasTag(ped, "Pedestal") then
					ped:SetAttribute("Item", "")
				end
			end
		end
	end
end)

-- Lógica de robo (TODO se valida aquí, en el servidor) ------------------
local ultimoRobo = {}

local function robar(ladron, pedestal)
	local personaje = ladron.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if not raiz then return false end
	if ladron:GetAttribute("Cargando") then return false end -- ya lleva un objeto

	local base = pedestal:FindFirstAncestorOfClass("Model")
	local duenoId = base and base:GetAttribute("Dueno")
	if not duenoId or duenoId == ladron.UserId then return false end

	local item = pedestal:GetAttribute("Item")
	if not item or item == "" then return false end

	if (raiz.Position - pedestal.Position).Magnitude > RANGO + 5 then return false end
	if os.clock() - (ultimoRobo[ladron] or 0) < COOLDOWN then return false end

	ultimoRobo[ladron] = os.clock()
	pedestal:SetAttribute("Item", "")
	ladron:SetAttribute("Cargando", item)

	local dueno = Players:GetPlayerByUserId(duenoId)
	if dueno then
		alertaEvento:FireClient(dueno, "¡" .. ladron.Name .. " te robó " .. item .. "!")
	end
	alertaEvento:FireClient(ladron, "Robaste " .. item .. ". ¡Llévalo a tu base!")
	return true
end

-- ProximityPrompt en cada pedestal (robo manual)
local function configurarPedestal(ped)
	if ped:FindFirstChildOfClass("ProximityPrompt") then return end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Robar"
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = RANGO
	prompt.RequiresLineOfSight = false
	prompt.Parent = ped

	local function actualizar()
		local item = ped:GetAttribute("Item")
		prompt.Enabled = item ~= nil and item ~= ""
	end
	ped:GetAttributeChangedSignal("Item"):Connect(actualizar)
	actualizar()

	prompt.Triggered:Connect(function(ladron)
		robar(ladron, ped)
	end)
end

for _, ped in ipairs(CollectionService:GetTagged("Pedestal")) do
	configurarPedestal(ped)
end
CollectionService:GetInstanceAddedSignal("Pedestal"):Connect(configurarPedestal)

-- Depositar el objeto robado en tu base
local function conectarDeposito(zona)
	local base = zona:FindFirstAncestorOfClass("Model")
	zona.Touched:Connect(function(parte)
		local jugador = Players:GetPlayerFromCharacter(parte.Parent)
		if not jugador then return end
		local cargando = jugador:GetAttribute("Cargando")
		if not cargando or base:GetAttribute("Dueno") ~= jugador.UserId then return end

		for _, ped in ipairs(base:GetDescendants()) do
			if CollectionService:HasTag(ped, "Pedestal") and (ped:GetAttribute("Item") or "") == "" then
				ped:SetAttribute("Item", cargando)
				jugador:SetAttribute("Cargando", nil)
				alertaEvento:FireClient(jugador, "¡Guardaste " .. cargando .. " en tu base!")
				return
			end
		end
	end)
end

for _, base in ipairs(workspace:WaitForChild("Bases"):GetChildren()) do
	local zona = base:FindFirstChild("ZonaDeposito")
	if zona then conectarDeposito(zona) end
end

-- AUTO ROBAR (función del gamepass) ----------------------------------
local function tienePase(jugador)
	if GAMEPASS_ID == 0 then return true end
	local ok, resultado = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(jugador.UserId, GAMEPASS_ID)
	end)
	return ok and resultado
end

autoRobarEvento.OnServerEvent:Connect(function(jugador, activar)
	if typeof(activar) ~= "boolean" then return end
	if activar and not tienePase(jugador) then
		MarketplaceService:PromptGamePassPurchase(jugador, GAMEPASS_ID)
		jugador:SetAttribute("AutoRobar", false)
		return
	end
	jugador:SetAttribute("AutoRobar", activar)
end)

-- Cada 0.5 s, los jugadores con Auto Robar activo roban el pedestal más cercano
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, jugador in ipairs(Players:GetPlayers()) do
			if jugador:GetAttribute("AutoRobar") and not jugador:GetAttribute("Cargando") then
				local raiz = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
				if raiz then
					local mejor, mejorDist = nil, RANGO
					for _, ped in ipairs(CollectionService:GetTagged("Pedestal")) do
						local dist = (raiz.Position - ped.Position).Magnitude
						local item = ped:GetAttribute("Item")
						if dist <= mejorDist and item and item ~= "" then
							mejor, mejorDist = ped, dist
						end
					end
					if mejor then robar(jugador, mejor) end
				end
			end
		end
	end
end)


--====================================================================
-- 2) LocalScript "RobarCliente"  (StarterGui)
--====================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local jugador = Players.LocalPlayer
local remotos = ReplicatedStorage:WaitForChild("RobarRemotos")

local gui = Instance.new("ScreenGui")
gui.Name = "RobarGui"
gui.ResetOnSpawn = false
gui.Parent = jugador:WaitForChild("PlayerGui")

-- Botón Auto Robar
local boton = Instance.new("TextButton")
boton.Text = "Auto Robar: OFF"
boton.Font = Enum.Font.GothamBlack
boton.TextSize = 18
boton.TextColor3 = Color3.new(1, 1, 1)
boton.BackgroundColor3 = Color3.fromRGB(200, 40, 70)
boton.Position = UDim2.new(0, 10, 0.7, 0)
boton.Size = UDim2.fromOffset(170, 44)
boton.Parent = gui
Instance.new("UICorner", boton).CornerRadius = UDim.new(0, 8)

local activo = false
boton.MouseButton1Click:Connect(function()
	activo = not activo
	remotos.AutoRobar:FireServer(activo)
end)

jugador:GetAttributeChangedSignal("AutoRobar"):Connect(function()
	activo = jugador:GetAttribute("AutoRobar") == true
	boton.Text = "Auto Robar: " .. (activo and "ON" or "OFF")
	boton.BackgroundColor3 = activo and Color3.fromRGB(40, 170, 80) or Color3.fromRGB(200, 40, 70)
end)

-- Mensajes de alerta (te robaron / robaste / guardaste)
local mensaje = Instance.new("TextLabel")
mensaje.BackgroundTransparency = 1
mensaje.Font = Enum.Font.GothamBlack
mensaje.TextSize = 28
mensaje.TextColor3 = Color3.fromRGB(255, 80, 80)
mensaje.TextStrokeTransparency = 0
mensaje.AnchorPoint = Vector2.new(0.5, 0)
mensaje.Position = UDim2.new(0.5, 0, 0.12, 0)
mensaje.Size = UDim2.fromOffset(700, 40)
mensaje.Text = ""
mensaje.Parent = gui

local contador = 0
remotos.Alerta.OnClientEvent:Connect(function(texto)
	contador += 1
	local mio = contador
	mensaje.Text = texto
	task.delay(3, function()
		if contador == mio then mensaje.Text = "" end
	end)
end)
